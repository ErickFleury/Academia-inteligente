{
  "realm": "academia",
  "enabled": true,
  "registrationAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@academia.test",
    "auth": "false",
    "starttls": "false",
    "ssl": "false"
  },
  "roles": {
    "realm": [
      { "name": "client" },
      { "name": "employee" },
      { "name": "attendant", "composite": true, "composites": { "realm": ["employee"] } },
      { "name": "instructor", "composite": true, "composites": { "realm": ["employee"] } },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "academia-provisioner",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_PROVISIONING_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "academia-web",
      "name": "Academia Inteligente web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "protocolMappers": [
        {
          "name": "account_active",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "account_active",
            "claim.name": "account_active",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${APP_ADMIN_USERNAME}",
      "enabled": true,
      "email": "${APP_ADMIN_USERNAME}",
      "emailVerified": true,
      "attributes": { "account_active": ["true"] },
      "realmRoles": ["admin"],
      "credentials": [
        {
          "type": "password",
          "value": "${APP_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-academia-provisioner",
      "enabled": true,
      "serviceAccountClientId": "academia-provisioner",
      "clientRoles": {
        "realm-management": ["manage-users", "query-users", "view-realm"]
      }
    }
  ]
}
