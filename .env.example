POSTGRES_DB=academia_inteligente
POSTGRES_USER=academia
POSTGRES_PASSWORD=replace-with-a-local-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
KEYCLOAK_PROVISIONING_CLIENT_SECRET=replace-with-a-local-provisioning-secret
KEYCLOAK_HOSTNAME=localhost
# Change the host port if another application already uses 8080.
KEYCLOAK_HTTP_PORT=8080
# Set to 0.0.0.0 only for testing from another device on your trusted LAN.
LOCAL_BIND_ADDRESS=127.0.0.1
# For HTTPS testing from a phone, set this to /api and use docker-compose.lan-https.yml.
VITE_DEV_HTTPS=false
DEV_CERT_DIR=/tmp/academia-inteligente-certificates
APP_ADMIN_USERNAME=replace-with-an-admin-username
APP_ADMIN_PASSWORD=replace-with-a-local-password
VITE_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
ACCESS_EVENT_INTEGRATION_SECRET=replace-with-a-local-access-event-secret
VITE_OIDC_ISSUER=http://localhost:8080/realms/academia
VITE_OIDC_CLIENT_ID=academia-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
SMTP_FROM=no-reply@academia.local
ONBOARDING_INVITATION_URL=http://localhost:5173/onboarding
AI_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_TIMEOUT_SECONDS=10
AI_RECENT_MESSAGE_LIMIT=6
# Local is the default. OpenAI requires explicit provider selection and credentials.
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_MODEL=embeddinggemma
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_REVISION=1
# Keep the small embedding model in system RAM on 8GB GPUs; -1 enables auto offload.
AI_EMBEDDING_GPU_LAYERS=0
# Pilot ceilings can be lowered for smaller machines; larger limits need validation.
AI_REFERENCE_MAX_ACTIVE_DOCUMENTS=100
AI_REFERENCE_MAX_UPLOAD_MIB=150
AI_REFERENCE_MAX_PDF_PAGES=1000
AI_REFERENCE_MAX_CHARACTERS=2000000
AI_EMBEDDING_TIMEOUT_SECONDS=10
AI_ORCHESTRATION_ENABLED=false
# Comma-separated local Client UUIDs; use * only for deliberate broad rollout.
AI_ORCHESTRATION_CLIENT_IDS=
OLLAMA_CONTEXT_TOKENS=32768
OLLAMA_CHAT_CONTEXT_TOKENS=8192
# Fixed window for the entire plan/adaptation workflow; overflow fails without truncation.
OLLAMA_PLAN_CONTEXT_TOKENS=8192
# Optional model overrides within the explicitly selected generation provider.
AI_MODEL_ORCHESTRATOR=
AI_MODEL_ONBOARDING=
AI_MODEL_INITIAL_PLAN=
AI_MODEL_TRAINING_CHAT=
AI_MODEL_ADAPTATION=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
# Models are provisioned once with the provision-models profile; ordinary startup never pulls them.
OLLAMA_DOCKER_TAG=0.34.1

# Local owner-only facial pilot. Provider network has no outbound route.
FACIAL_ACCESS_MODE=disabled
COMPREFACE_DATABASE_PASSWORD=
COMPREFACE_API_KEY=
BIOMETRIC_DETECTION_THRESHOLD=0.90
BIOMETRIC_MATCH_THRESHOLD=0.80
BIOMETRIC_AMBIGUITY_MARGIN=0.10
BIOMETRIC_TIMEOUT_SECONDS=10
